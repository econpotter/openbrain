# PostgreSQL connection string
# Example: postgresql://myuser:mypassword@localhost/openbrain
DATABASE_URL=postgresql://localhost/openbrain

# Embedding backend: "local" (default, free) or "voyage" (paid API)
EMBED_BACKEND=local

# Local embedding model — used when EMBED_BACKEND=local
# Downloads automatically on first use (~1.3 GB, cached in ~/.cache/huggingface/)
EMBED_MODEL_LOCAL=BAAI/bge-large-en-v1.5

# Voyage AI — only needed when EMBED_BACKEND=voyage
# VOYAGE_API_KEY=your_voyage_api_key_here
# VOYAGE_MODEL=voyage-large-2

# MCP server transport: stdio (for local dev/testing) or http (for remote clients)
MCP_TRANSPORT=http

# Port for HTTP transport
PORT=8000

# Directory where ingested documents are stored
LIBRARY_PATH=~/library
