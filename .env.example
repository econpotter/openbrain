# PostgreSQL connection string
# Example: postgresql://myuser:mypassword@localhost/openbrain
DATABASE_URL=postgresql://localhost/openbrain

# Voyage AI API key — https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Embedding model (voyage-large-2 = 1024 dims, matches schema VECTOR(1024))
EMBED_MODEL=voyage-large-2

# MCP server transport: stdio (for local dev/testing) or sse (for Claude.ai remote)
MCP_TRANSPORT=sse

# Port for SSE transport
PORT=8000
