# Secrets only — non-secret config goes in config.yaml

# Database connection (contains credentials — keep out of config.yaml)
DATABASE_URL=postgresql://user:password@localhost/openbrain

# Embedding API keys — set the one matching embed.provider in config.yaml
VOYAGE_API_KEY=
OPENROUTER_API_KEY=
LITELLM_API_KEY=     # any string works for a local LiteLLM instance

# MCP HTTP auth token — optional, but recommended for remote access
MCP_ACCESS_KEY=

# Paper source API keys — optional. Only Semantic Scholar uses one (raises rate
# limits). OpenAlex, CrossRef, and arXiv need none.
SEMANTIC_SCHOLAR_API_KEY=
