[Unit]
Description=openbrain thin-client sweep (flush the spool)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The thin client installed by `uv tool install` lands on the user's PATH.
# Config (OPENBRAIN_MCP_URL/KEY) comes from the environment or
# ~/.openbrain/config.yaml; the optional env file below can carry the key.
EnvironmentFile=-%h/.openbrain/env
ExecStart=%h/.local/bin/openbrain sweep
ExecStart=%h/.local/bin/openbrain sync-projects
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
