[Unit]
Description=Open Brain MCP Server
After=network.target postgresql.service

[Service]
User=__USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/.venv/bin/python mcp_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
